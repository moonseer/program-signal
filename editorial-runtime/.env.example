# Workflow state (canonical). Fall back: JSON files under editorial-runtime/runs/
# DATABASE_URL=postgresql://platform_signal:platform_signal@127.0.0.1:5432/editorial
# PS_DATABASE_URL=postgresql://platform_signal:platform_signal@127.0.0.1:5432/editorial

# Provider API keys (at least one required for --live)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional capability overrides (provider:model)
# OPENROUTER_API_KEY=
# PS_MODEL_RESEARCH=openrouter:openai/gpt-4o-mini
# PS_MODEL_REASONING=openrouter:openai/gpt-4o-mini
# PS_MODEL_WRITER=openrouter:openai/gpt-4o
# PS_MODEL_FAST=openrouter:openai/gpt-4o-mini

# LiteLLM proxy (optional — point OpenAI-compatible clients at a LiteLLM gateway)
# OPENAI_API_BASE=http://127.0.0.1:4000/v1
# OPENAI_BASE_URL=http://127.0.0.1:4000/v1
# OPENAI_API_KEY=
# Capability models should match LiteLLM aliases, e.g.
# PS_MODEL_RESEARCH=openai:atlas-general
# PS_MODEL_REASONING=openai:atlas-general
# PS_MODEL_WRITER=openai:atlas-general
# PS_MODEL_FAST=openai:atlas-fast
