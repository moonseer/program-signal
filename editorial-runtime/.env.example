# Provider API keys (at least one required for --live)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional capability overrides (provider:model)
# PS_MODEL_RESEARCH=openai:gpt-4o-mini
# PS_MODEL_REASONING=openai:gpt-4o-mini
# PS_MODEL_WRITER=anthropic:claude-3-5-sonnet-latest
# PS_MODEL_FAST=openai:gpt-4o-mini

# LiteLLM proxy (optional — point OpenAI-compatible clients at a LiteLLM gateway)
# OPENAI_API_BASE=http://localhost:4000/v1
# OPENAI_API_KEY=sk-litellm-master-key
